<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Role title (Mentor / Student Name) + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_mr_initial"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mr_role_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MENTOR"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mr_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tv_mr_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_grey"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PENDING"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Message from request -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="MESSAGE"
            android:textSize="9sp"
            android:textColor="@color/text_muted"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mr_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="I would love some career guidance."
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Response Note (if accepted/rejected with comments) -->
        <LinearLayout
            android:id="@+id/layout_mr_response_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F8FAFC"
            android:padding="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESPONSE NOTE"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mr_response_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Let's connect soon."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Date row -->
        <TextView
            android:id="@+id/tv_mr_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sent on: 18 Aug 2026"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <!-- Actions layout (visible/invisible depending on state/role) -->
        <LinearLayout
            android:id="@+id/layout_mr_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone">

            <!-- Reject Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mr_reject"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Reject"
                android:textColor="@color/error"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <!-- Accept Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mr_accept"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary"
                android:text="Accept"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <!-- Complete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mr_complete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/success"
                android:text="Mark Complete"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
