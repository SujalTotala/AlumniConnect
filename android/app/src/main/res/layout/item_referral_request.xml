<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Opp Title + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_ref_opp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senior Software Engineer"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ref_opp_company"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Google • Mountain View, CA"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_ref_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_grey"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PENDING"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Person info row: Requester or Alumni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_ref_person_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="U"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_ref_person_role_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUESTED BY"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ref_person_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe (Student)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_ref_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="May 10"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Note message -->
        <LinearLayout
            android:id="@+id/layout_ref_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTE"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ref_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Here is my portfolio and notes..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:id="@+id/layout_ref_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Cancel Button (Requester) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ref_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="14dp"
                android:text="Cancel Request"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                app:strokeColor="@color/border"
                app:cornerRadius="8dp"
                android:visibility="gone" />

            <!-- Decline Button (Alumni) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ref_decline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:text="Decline"
                android:textAllCaps="false"
                android:textColor="@color/error"
                android:textSize="12sp"
                app:strokeColor="@color/error"
                app:cornerRadius="8dp"
                android:visibility="gone" />

            <!-- Accept Button (Alumni) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ref_accept"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/primary"
                android:paddingHorizontal="16dp"
                android:text="Accept"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                android:visibility="gone" />

            <!-- Mark Completed Button (Alumni) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ref_complete"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/success"
                android:paddingHorizontal="16dp"
                android:text="Mark Submitted"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
