<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="28dp">

            <TextView
                android:id="@+id/tv_detail_initials"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_circle_large"
                android:gravity="center"
                android:text="AL"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Alumni Name"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Engineer @ Company"
                android:textColor="#BFDBFE"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_detail_mentor_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#3D22C55E"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="✓ Available for Mentorship"
                android:textColor="#86EFAC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="Profile Details"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Each field row is defined here -->
                <LinearLayout
                    android:id="@+id/row_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="EMAIL" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_email"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_dept"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DEPARTMENT" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_dept"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_year"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="GRADUATION YEAR" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_year"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_company"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="COMPANY" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_company"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_jobrole"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="JOB ROLE" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_jobrole"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_location"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOCATION" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_location"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_skills"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SKILLS" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_skills"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_bio"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="14dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="BIO" android:textSize="9sp" android:textColor="@color/text_muted" android:textAllCaps="true" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_detail_bio"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_primary" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- LinkedIn -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_linkedin"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#0A66C2"
                    android:layout_marginBottom="10dp"
                    android:text="🔗 View on LinkedIn"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    android:visibility="gone" />

                <!-- GitHub -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_github"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#1F2937"
                    android:layout_marginBottom="10dp"
                    android:text="⚡ View on GitHub"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    android:visibility="gone" />

                <!-- Request Mentorship (Student viewing a mentor alumni) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_request_mentorship"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/success"
                    android:text="🎓 Request Mentorship"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
