<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_placeholder_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔧"
        android:textSize="48sp" />

    <TextView
        android:id="@+id/tv_placeholder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Coming in Next Phase"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_placeholder_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="This feature will be connected to the shared backend in the next phase."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
