# Database Connection URL (use SQLite for local development)
# Example PostgreSQL (production): postgresql://user:password@host:5432/alumniconnect
DATABASE_URL=sqlite:///./alumni.db

# Environment: development | testing | production
# Set to 'production' in production environments
ENVIRONMENT=development

# JWT Security Settings (PLACEHOLDERS - replace in your environment)
SECRET_KEY=CHANGE_ME_WITH_STRONG_SECRET
ALGORITHM=HS256
# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins (no trailing slash)
# Example: http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173
